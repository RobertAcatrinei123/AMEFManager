<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AMEFManager.ViewModels.UserControls"
             xmlns:models="clr-namespace:AMEFManager.Models"
             xmlns:helpers="clr-namespace:AMEFManager.Helpers"
             xmlns:uc="clr-namespace:AMEFManager.Views.UserControls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AMEFManager.Views.UserControls.ContractUserControl"
             x:DataType="vm:ContractUserControlViewModel">

    <UserControl.Resources>
        <helpers:ContractDisplayConverter x:Key="ContractDisplayConverter" />
    </UserControl.Resources>

    <Panel>
        <!-- Loading Indicator -->
        <StackPanel IsVisible="{Binding IsLoading}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Margin="0,20">
            <ProgressBar IsIndeterminate="True" Width="200" />
            <TextBlock Text="Se încarcă contractele..."
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

        <!-- Main Content -->
        <StackPanel IsVisible="{Binding !IsLoading}" Spacing="16">
            <!-- Card 1: Date Contract -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Separator Margin="0,0,0,8" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <!-- Selector -->
                    <StackPanel Margin="0,0,0,12" MaxWidth="500" HorizontalAlignment="Left">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="✕"
                                    Command="{Binding ClearSelectedContractCommand}"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Curăță selecția" />
                            <ComboBox ItemsSource="{Binding FilteredContracts}"
                                      SelectedItem="{Binding SelectedContract}"
                                      PlaceholderText="Contract nou..."
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Contract">
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource ContractDisplayConverter}">
                                                    <Binding Path="Number" />
                                                    <Binding Path="Date" />
                                                    <Binding Path="Type.Name" />
                                                    <Binding Path="Type.Value" />
                                                    <Binding Path="Client.Name" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>

                    <!-- Fields -->
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,12" MinWidth="150" Width="200">
                            <TextBlock Text="Număr *" FontWeight="Medium" Margin="0,0,0,4" />
                            <NumericUpDown Value="{Binding Number}" Minimum="0" FormatString="0" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12" MinWidth="220" Width="280">
                            <TextBlock Text="Dată *" FontWeight="Medium" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding Date}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12" MinWidth="220" Width="280">
                            <TextBlock Text="Valabil până la *" FontWeight="Medium" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding ValidUntil}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12" MinWidth="150" Width="200" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding IsActive}" Content="Este activ?" Margin="0,20,0,0" FontWeight="Medium" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Embedded Contract Type UserControl (Indented) -->
            <StackPanel Margin="16,0,0,0">
                <uc:ContractTypeUserControl DataContext="{Binding ContractTypeUserControlViewModel}" />
            </StackPanel>

            <!-- Card 3: Embedded Client UserControl (Indented) -->
            <StackPanel Margin="16,0,0,0">
                <uc:ClientUserControl DataContext="{Binding ClientUserControlViewModel}" />
            </StackPanel>

            <!-- Card 4: Echipamente AMEF din Contract (Indented) -->
            <StackPanel Margin="16,0,0,0">
                <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Echipamente AMEF din Contract" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Separator Margin="0,0,0,8" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                        <TextBlock Text="Niciun aparat AMEF asociat acestui contract."
                                   IsVisible="{Binding !Amefs.Count}"
                                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                                   FontStyle="Italic"
                                   Margin="0,4" />

                        <ItemsControl ItemsSource="{Binding Amefs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Amef">
                                    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                                            CornerRadius="6" 
                                            Padding="12,8" 
                                            Margin="0,0,0,8">
                                        <TextBlock VerticalAlignment="Center" FontWeight="Medium">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} - Seria: {1} (NUI: {2})">
                                                    <Binding Path="Model" />
                                                    <Binding Path="Series" />
                                                    <Binding Path="NUI" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Panel>
</UserControl>
