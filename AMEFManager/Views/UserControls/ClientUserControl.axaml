<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AMEFManager.ViewModels.UserControls"
             xmlns:models="clr-namespace:AMEFManager.Models"
             xmlns:helpers="clr-namespace:AMEFManager.Helpers"
             xmlns:uc="clr-namespace:AMEFManager.Views.UserControls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AMEFManager.Views.UserControls.ClientUserControl"
             x:DataType="vm:ClientUserControlViewModel">

    <UserControl.Resources>
        <helpers:ClientDisplayConverter x:Key="ClientDisplayConverter" />
    </UserControl.Resources>

    <Panel>
        <!-- Loading Indicator -->
        <StackPanel IsVisible="{Binding IsLoading}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Margin="0,20">
            <ProgressBar IsIndeterminate="True" Width="200" />
            <TextBlock Text="Se încarcă clienții..."
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

        <!-- Main Content -->
        <StackPanel IsVisible="{Binding !IsLoading}" Spacing="16">
            <!-- Card 1: Date Societate Comercială -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Separator Margin="0,0,0,8" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <!-- Selector -->
                    <StackPanel Margin="0,0,0,12" MaxWidth="500" HorizontalAlignment="Left">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="✕"
                                    Command="{Binding ClearSelectedClientCommand}"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Curăță selecția" />
                            <ComboBox ItemsSource="{Binding FilteredClients}"
                                      SelectedItem="{Binding SelectedClient}"
                                      PlaceholderText="Client nou..."
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Client">
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource ClientDisplayConverter}">
                                                    <Binding Path="Name" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>

                    <!-- Fields -->
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,12" MinWidth="250" Width="350">
                            <TextBlock Text="Nume firmă *" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Name}" PlaceholderText="Ex: SC EXEMPLU SRL" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12" MinWidth="220" Width="280">
                            <TextBlock Text="CUI / CIF *" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding NationalIdentifier}" PlaceholderText="Ex: 12345678" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12" MinWidth="220" Width="280">
                            <TextBlock Text="Nr. înregistrare *" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding RegistrationNumber}" PlaceholderText="Ex: J40/1234/2020" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12" MinWidth="150" Width="200" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding PaysTVA}" Content="Plătitor TVA" Margin="0,20,0,0" FontWeight="Medium" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Embedded Address UserControl (Indented) -->
            <StackPanel Margin="16,0,0,0">
                <uc:AddressUserControl DataContext="{Binding AddressUserControlViewModel}" />
            </StackPanel>

            <!-- Card 3: Embedded Representative (Person) UserControl (Indented) -->
            <StackPanel Margin="16,0,0,0">
                <uc:PersonUserControl DataContext="{Binding PersonUserControlViewModel}" />
            </StackPanel>
        </StackPanel>
    </Panel>
</UserControl>
