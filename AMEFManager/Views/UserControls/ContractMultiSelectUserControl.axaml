<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AMEFManager.ViewModels.UserControls"
             xmlns:models="clr-namespace:AMEFManager.Models"
             xmlns:helpers="clr-namespace:AMEFManager.Helpers"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AMEFManager.Views.UserControls.ContractMultiSelectUserControl"
             x:DataType="vm:ContractMultiSelectUserControlViewModel">

    <UserControl.Resources>
        <helpers:ContractDisplayConverter x:Key="ContractDisplayConverter" />
    </UserControl.Resources>

    <Panel>
        <!-- Loading Indicator -->
        <StackPanel IsVisible="{Binding IsLoading}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Margin="0,20">
            <ProgressBar IsIndeterminate="True" Width="200" />
            <TextBlock Text="Se încarcă contractele..."
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

        <!-- Main Content -->
        <StackPanel IsVisible="{Binding !IsLoading}" Spacing="16">
            <!-- Card 1: Filtrare & Adăugare Contracte -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Filtrare &amp; Adăugare Contracte" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Separator Margin="0,0,0,8" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,12" MinWidth="150" Width="200">
                            <TextBlock Text="Număr contract" FontWeight="Medium" Margin="0,0,0,4" />
                            <NumericUpDown Value="{Binding Number}" Minimum="0" FormatString="0" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- Selector to Add -->
                    <StackPanel Margin="0,8,0,0" MaxWidth="500" HorizontalAlignment="Left">
                        <TextBlock Text="Selectează contract pentru a-l adăuga în listă:" FontWeight="Medium" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding FilteredContracts}"
                                  SelectedItem="{Binding ContractToAdd}"
                                  PlaceholderText="Alege un contract..."
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Contract">
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource ContractDisplayConverter}">
                                                <Binding Path="Number" />
                                                <Binding Path="Date" />
                                                <Binding Path="Type.Name" />
                                                <Binding Path="Type.Value" />
                                                <Binding Path="Client.Name" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Contracte Selectate -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Contracte Selectate" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Separator Margin="0,0,0,8" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <TextBlock Text="Niciun contract selectat."
                               IsVisible="{Binding !SelectedContracts.Count}"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                               FontStyle="Italic"
                               Margin="0,4" />

                    <ItemsControl ItemsSource="{Binding SelectedContracts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Contract">
                                <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" 
                                        CornerRadius="6" 
                                        Padding="12,8" 
                                        Margin="0,0,0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" 
                                                Content="✕" 
                                                Command="{Binding $parent[UserControl].((vm:ContractMultiSelectUserControlViewModel)DataContext).RemoveContractCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Center"
                                                Margin="16,0,0,0"
                                                ToolTip.Tip="Elimină din selecție" />
                                        <TextBlock VerticalAlignment="Center" FontWeight="Medium">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource ContractDisplayConverter}">
                                                    <Binding Path="Number" />
                                                    <Binding Path="Date" />
                                                    <Binding Path="Type.Name" />
                                                    <Binding Path="Type.Value" />
                                                    <Binding Path="Client.Name" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Panel>
</UserControl>
