<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AMEFManager.ViewModels.UserControls"
             xmlns:views="clr-namespace:AMEFManager.Views.UserControls"
             xmlns:helpers="clr-namespace:AMEFManager.Helpers"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AMEFManager.Views.UserControls.DeliveryDocumentUserControl"
             x:DataType="vm:DeliveryDocumentUserControlViewModel">

    <UserControl.Resources>
        <helpers:DeliveryDocumentDisplayConverter x:Key="DeliveryDocumentDisplayConverter"/>
    </UserControl.Resources>

    <Panel>
        <!-- Loading Indicator -->
        <StackPanel IsVisible="{Binding IsLoading}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Margin="0,20">
            <ProgressBar IsIndeterminate="True" Width="200" />
            <TextBlock Text="Se încarcă procesele verbale..."
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

        <!-- Main Content -->
        <StackPanel IsVisible="{Binding !IsLoading}" Spacing="16">
            <!-- Card 1: Date Proces Verbal -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Separator Margin="0,0,0,8" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <!-- Selector -->
                    <StackPanel Margin="0,0,0,12" MaxWidth="500" HorizontalAlignment="Left">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="✕"
                                    Command="{Binding ClearSelectedDeliveryDocumentCommand}"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Curăță selecția" />
                            <ComboBox ItemsSource="{Binding FilteredDeliveryDocuments}"
                                      SelectedItem="{Binding SelectedDeliveryDocument}"
                                      PlaceholderText="Proces verbal nou..."
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource DeliveryDocumentDisplayConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>

                    <!-- Fields -->
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,12" MinWidth="150" Width="200">
                            <TextBlock Text="Număr *" FontWeight="Medium" Margin="0,0,0,4" />
                            <NumericUpDown Minimum="0" FormatString="0" Value="{Binding Number}" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12" MinWidth="220" Width="280">
                            <TextBlock Text="Dată *" FontWeight="Medium" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding Date}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Embedded AMEF UserControl (Indented) -->
            <StackPanel Margin="16,0,0,0">
                <views:AmefUserControl DataContext="{Binding AmefUserControlViewModel}" />
            </StackPanel>
        </StackPanel>
    </Panel>
</UserControl>
