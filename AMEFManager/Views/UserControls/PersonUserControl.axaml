<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AMEFManager.ViewModels.UserControls"
             xmlns:models="clr-namespace:AMEFManager.Models"
             xmlns:helpers="clr-namespace:AMEFManager.Helpers"
             xmlns:uc="clr-namespace:AMEFManager.Views.UserControls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AMEFManager.Views.UserControls.PersonUserControl"
             x:DataType="vm:PersonUserControlViewModel">

    <UserControl.Resources>
        <helpers:PersonDisplayConverter x:Key="PersonDisplayConverter" />
    </UserControl.Resources>

    <Panel>
        <!-- Loading Indicator -->
        <StackPanel IsVisible="{Binding IsLoading}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12"
                    Margin="0,20">
            <ProgressBar IsIndeterminate="True" Width="200" />
            <TextBlock Text="Se încarcă persoanele..."
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </StackPanel>

        <!-- Main Content -->
        <StackPanel IsVisible="{Binding !IsLoading}" Spacing="16">
            <!-- Card 1: Date Personale & Contact -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Separator Margin="0,0,0,8" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <!-- Selector -->
                    <StackPanel Margin="0,0,0,12" MaxWidth="500" HorizontalAlignment="Left">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="✕"
                                    Command="{Binding ClearSelectedPersonCommand}"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Curăță selecția" />
                            <ComboBox ItemsSource="{Binding FilteredPersons}"
                                      SelectedItem="{Binding SelectedPerson}"
                                      PlaceholderText="Persoană nouă..."
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Person">
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource PersonDisplayConverter}">
                                                    <Binding Path="LastName" />
                                                    <Binding Path="FirstName" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>

                    <!-- Fields -->
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,12" MinWidth="200" Width="250">
                            <TextBlock Text="Nume *" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding LastName}" PlaceholderText="Ex: Popescu" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12" MinWidth="200" Width="250">
                            <TextBlock Text="Prenume *" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FirstName}" PlaceholderText="Ex: Ion" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12" MinWidth="200" Width="250">
                            <TextBlock Text="CNP *" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Cnp}" PlaceholderText="Ex: 1850101123456" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12" MinWidth="200" Width="250">
                            <TextBlock Text="Email" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Email}" PlaceholderText="Ex: ion.popescu@firma.ro" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12" MinWidth="200" Width="250">
                            <TextBlock Text="Telefon" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Phone}" PlaceholderText="Ex: 0722123456" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12" MinWidth="200" Width="250">
                            <TextBlock Text="Rol *" FontWeight="Medium" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableRoles}"
                                      SelectedItem="{Binding Role}"
                                      PlaceholderText="Selectează rol..."
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Act de Identitate -->
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Act de Identitate" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <Separator Margin="0,0,0,8" Background="{DynamicResource SystemControlForegroundBaseLowBrush}"/>

                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,16,12" MinWidth="120" Width="150">
                            <TextBlock Text="Seria *" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Series}" PlaceholderText="Ex: RX" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12" MinWidth="120" Width="150">
                            <TextBlock Text="Număr *" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Number}" PlaceholderText="Ex: 123456" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12" MinWidth="200" Width="250">
                            <TextBlock Text="Emitent *" FontWeight="Medium" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Issuer}" PlaceholderText="Ex: SPCLEP Sector 1" />
                        </StackPanel>

                        <StackPanel Margin="0,0,16,12" MinWidth="220" Width="280">
                            <TextBlock Text="Data emiterii *" FontWeight="Medium" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding IssuingDate}" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: Embedded Address UserControl (Indented) -->
            <StackPanel Margin="16,0,0,0">
                <uc:AddressUserControl DataContext="{Binding AddressUserControlViewModel}" />
            </StackPanel>
        </StackPanel>
    </Panel>
</UserControl>
