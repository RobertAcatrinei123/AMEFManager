<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AMEFManager.ViewModels.Windows"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
             x:Class="AMEFManager.Views.Windows.BackupWindowView"
             x:DataType="vm:BackupWindowViewModel">
    
    <StackPanel Spacing="10" Margin="20">
        <TextBlock Text="Setari Backup" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <TextBlock Text="Numar de zile intre backup-uri (0 pentru dezactivare):"/>
        <NumericUpDown Value="{Binding BackupIntervalDays}" Minimum="0" Maximum="365" Width="200" HorizontalAlignment="Left"/>
        
        <TextBlock Text="Numar de backup-uri de pastrat (0 pentru dezactivare):"/>
        <NumericUpDown Value="{Binding BackupsToKeep}" Minimum="0" Maximum="100" Width="200" HorizontalAlignment="Left"/>
        
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,20">
            <Button Content="Salveaza Setari" Command="{Binding SaveCommand}" HorizontalContentAlignment="Center"/>
            <Button Content="Creaza Backup Acum" Command="{Binding CreateBackupNowCommand}" HorizontalContentAlignment="Center"/>
        </StackPanel>
        
        <TextBlock Text="Restaurare Backup" FontSize="20" FontWeight="Bold" Margin="0,20,0,10"/>
        
        <TextBlock Text="Selectati un backup existent:"/>
        <ComboBox ItemsSource="{Binding AvailableBackups}" SelectedItem="{Binding SelectedBackup}" Width="300" HorizontalAlignment="Left"/>
        
        <Button Content="Restaureaza" Command="{Binding RestoreCommand}" Background="#ef4444" Foreground="White" Width="150" HorizontalContentAlignment="Center" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
