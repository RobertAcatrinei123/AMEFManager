<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:AMEFManager.ViewModels.Windows"
             xmlns:uc="clr-namespace:AMEFManager.Views.UserControls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="AMEFManager.Views.Windows.AdditionalDocumentWindowView"
             x:DataType="vm:AdditionalDocumentWindowViewModel">

    <DockPanel>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Șterge"
                    Command="{Binding DeleteCommand}"
                    Background="#ef4444"
                    Foreground="White"
                    HorizontalContentAlignment="Center"
                    MinWidth="120"
                    Margin="0,0,16,0" />
            <Button Content="Salveaza"
                    Command="{Binding SaveCommand}"
                    HorizontalContentAlignment="Center"
                    MinWidth="120" />
        </StackPanel>

        <uc:AdditionalDocumentUserControl DataContext="{Binding DocumentUserControlViewModel}" />

    </DockPanel>

</UserControl>
